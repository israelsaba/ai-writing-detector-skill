#!/usr/bin/env bash
# ai-tells-lint: shell wrapper for the Python linter.
# Part of the `anti-ai-tells` OpenCode skill.
#
# Usage: ai-tells-lint <file> [--strict] [--format text|json]
#
# This wrapper finds a usable python3 and runs the sibling ai-tells-lint.py.
# Add this skill's `bin` directory to your PATH to use the `ai-tells-lint` command
# from any directory:
#     export PATH="/path/to/skill/bin:$PATH"
#
# Or call with full path:
#     /path/to/skill/bin/ai-tells-lint <file>

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
linter="$script_dir/ai-tells-lint.py"

if [ ! -f "$linter" ]; then
    echo "Linter script not found at $linter" >&2
    exit 127
fi

# Prefer whatever python3 is in PATH; fall back to a sensible default.
py="${PYTHON3:-python3}"
if ! command -v "$py" >/dev/null 2>&1; then
    echo "python3 not found (tried: $py)" >&2
    exit 127
fi

exec "$py" "$linter" "$@"
